# ---- 依赖与构建产物 ----
node_modules/
target/
dist/
build/Release/
*.jar
!gradle/wrapper/*.jar

# ---- 运行时数据（绝不入库）----
# SQLite 业务库、录像分片、上传文件都是运行时产物，且可能含真实业务数据
*.db
*.db-shm
*.db-wal
data/
recordings/
recording-exports/
uploads/

# ---- 日志与验证快照 ----
*.log
logs/
.verification/

# ---- 本地工作区与内部开发流程（非项目资产，不对外发布）----
.codex/
.claude/
openspec/
# pi agent 的任务收件箱与进度外送：跨 agent 协作的运行时产物，绝不入库
.pi/inbox/
.pi/outbox/

# ---- 本地环境变量 ----
# 约定：仓库内的 .env / .env.prod / .env.test 只放占位符，
# 真实密钥（如高德地图 key）写入下面这些文件，它们永远不会被提交。
.env.local
.env.*.local

# ---- 编辑器与系统 ----
.idea/
*.iml
.DS_Store
Thumbs.db
