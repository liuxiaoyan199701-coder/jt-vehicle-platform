# Copy this file outside the repository, fill every required value, then run
# deployment scripts with DEPLOY_ENV_FILE=/etc/jt-deploy/deploy.env.

# Public routing. Use names or addresses that devices and browsers can reach.
PUBLIC_HOST=console.example.invalid
MEDIA_REACHABLE_ADDRESS=media.example.invalid

# JDK installation. The digest is mandatory and must come from a trusted
# release channel, not from the download response itself.
JDK_HOME=/opt/jt-jdk/current-jdk
JDK_ARCHIVE_URL=https://downloads.example.invalid/OpenJDK25U-jdk.tar.gz
JDK_ARCHIVE_SHA256=

# Release artifacts. RELEASE_ID may contain letters, digits, dots, dashes and
# underscores. All three digests are mandatory before any current link moves.
RELEASE_ID=
JT_PLATFORM_JAR=/srv/jt-release/jt-platform.jar
JT_PLATFORM_JAR_SHA256=
JT_CONSOLE_JAR=/srv/jt-release/jt-console.jar
JT_CONSOLE_JAR_SHA256=
JT_CONSOLE_UI_ARCHIVE=/srv/jt-release/jt-console-ui.tar.gz
JT_CONSOLE_UI_SHA256=

# TLS_MODE must be production or development. Production requires an existing
# trusted full-chain certificate and matching private key. Development creates
# a short-lived self-signed certificate and is not a production baseline.
TLS_MODE=production
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
TLS_DEVELOPMENT_CERT_DIR=/etc/nginx/jt-console-development-tls

# FIREWALL_MODE must be ufw or external. external additionally requires
# EXTERNAL_FIREWALL_CONFIRMED=true so deployment cannot silently fail open.
FIREWALL_MODE=ufw
EXTERNAL_FIREWALL_CONFIRMED=false
SSH_PORT=22

# Runtime sizing and bounded health checks.
CONSOLE_ADMIN_USERNAME=admin
BCRYPT_COST=12
HEALTH_TIMEOUT_SECONDS=60
HEALTH_RETRY_SECONDS=1
JT_PLATFORM_XMS=256m
JT_PLATFORM_XMX=1g
JT_CONSOLE_XMS=128m
JT_CONSOLE_XMX=512m
MEDIA_MAX_STREAMS=20
MEDIA_MAX_OUTBOUND_BPS=50000000

# Device and player authentication remain explicit deployment choices. An
# empty local list denies terminal registration until identifiers are added.
DEVICE_AUTH_MODE=local-list
DEVICE_LOCAL_LIST=
STREAM_AUTH_MODE=disabled

# Package installation is explicit for reproducible image-based hosts.
INSTALL_SYSTEM_PACKAGES=true
