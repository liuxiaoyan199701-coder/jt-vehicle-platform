<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.jtplatform</groupId>
        <artifactId>jt-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>jt-terminal-simulator</artifactId>
    <name>JT Platform Terminal Simulator</name>
    <description>Windows JT/T 808 and JT/T 1078 camera terminal simulator</description>

    <dependencies>
        <dependency>
            <groupId>io.github.jtplatform</groupId>
            <artifactId>jt-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-server-frameworks</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.springframework:spring-context</exclude>
                                        <exclude>org.springframework.boot:*</exclude>
                                        <exclude>io.github.jtplatform:jt-signal</exclude>
                                        <exclude>io.github.jtplatform:jt-media</exclude>
                                        <!--
                                          jt-common 里有一个同名的坐标换算工具，看上去正好能复用。
                                          它不行：境内边界与控制台那份不一致，本身在生产代码里也无人调用，
                                          而控制台是独立工程、这里根本依赖不到它实际在用的那个函数。
                                          模拟器自带 trip/CoordinateTransform，禁掉这条依赖让该决定自我强制。
                                        -->
                                        <exclude>io.github.jtplatform:jt-common</exclude>
                                    </excludes>
                                    <message>The terminal simulator must remain independent from server runtimes.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.github.jtplatform.simulator.SimulatorLauncher</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/app/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>io.github.jtplatform.simulator.SimulatorLauncher</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
