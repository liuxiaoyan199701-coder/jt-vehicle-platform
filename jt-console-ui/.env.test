# 开发环境：经 vite 代理转发到本地运行的 jt-console
VITE_SERVICE_BASE_URL=http://127.0.0.1:8300/api

# WebSocket 实时位置推送。留空则按当前页面 host 推导
VITE_WS_URL=ws://127.0.0.1:8300/ws/live

# 高德地图 JS API。需自行到 https://lbs.amap.com 申请「Web端(JS API)」类型的 key。
# 真实值请写入 .env.local（已被 .gitignore 排除），不要提交到版本库。
# 留空时地图区域会降级为提示占位，其余功能不受影响。
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

VITE_OTHER_SERVICE_BASE_URL= `{}`
