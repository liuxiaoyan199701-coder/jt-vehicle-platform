# 生产环境：前端与后端由同一个 nginx 提供，/api 反向代理到 jt-console
VITE_SERVICE_BASE_URL=/api

# 留空表示按当前页面地址推导为 ws(s)://<host>/ws/live
VITE_WS_URL=

# 高德地图 JS API。需自行到 https://lbs.amap.com 申请「Web端(JS API)」类型的 key。
# 不要把真实值写在这里——本文件会被提交到版本库。请复制一份 .env.local 并写入其中，
# Vite 会用 .env.local 覆盖同名变量，且它已被 .gitignore 排除。
# 安全密钥（jscode）按高德的设计属于服务端凭据，放在前端等同于公开配额与计费，
# 生产环境应改为由 nginx 反向代理 /_AMapService 后在服务端注入。
# 留空时地图区域会降级为提示占位，其余功能不受影响。
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

VITE_OTHER_SERVICE_BASE_URL= `{}`
